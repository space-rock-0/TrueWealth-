# Optional server-side provider keys. Users can instead enter their own keys in
# AI Provider Settings; per-request browser keys override these fallbacks.
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional model overrides (defaults shown)
MODEL_ANSWER=openai/gpt-oss-120b
MODEL_REASONING=llama-3.3-70b-versatile
MODEL_CLASSIFY=llama-3.1-8b-instant

# Optional local API behavior
RATE_LIMIT_ENABLED=true
RATE_LIMIT=20/minute
# SQLITE_PATH=path/to/truewealth.sqlite3

# Authentication (local defaults allow account creation without email delivery)
APP_ENV=development
RETRIEVAL_BACKEND=semantic
# Free cloud deploys use lexical retrieval to avoid loading PyTorch locally.
# HTTPS email works on hosts that block SMTP ports:
# EMAIL_PROVIDER=brevo
# EMAIL_FROM=sagi15sid05@gmail.com
# BREVO_API_KEY=
# Or EMAIL_PROVIDER=resend with a verified-domain sender and RESEND_API_KEY.
EMAIL_VERIFICATION_REQUIRED=false
# Set these in production; APP_ALLOWED_ORIGINS should list the public frontend origins.
APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
# Production should use persistent PostgreSQL, not local SQLite:
# DATABASE_URL=postgresql://user:password@host:5432/truewealth
# Required in production when email verification is enabled:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=TrueWealth AI <no-reply@example.com>
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_STARTTLS=true

# Outbound tool timeouts and retry counts
TOOL_TIMEOUT_SECONDS=8
TOOL_RETRY_LIMIT=1
MARKET_DESK_TIMEOUT_SECONDS=15

# Cache durations in seconds
EMBEDDING_CACHE_TTL=604800
RAG_CACHE_TTL=1800
MARKET_QUOTE_CACHE_TTL=45
NEWS_CACHE_TTL=600
DDG_CACHE_TTL=1200
ANSWER_CACHE_TTL=120
CACHE_MAXSIZE=256
GATEWAY_CACHE_TTL=300
GATEWAY_RETRY_LIMIT=1

# Due diligence behavior
DUE_DILIGENCE_SKIP_WHEN_CLEAN=true
DUE_DILIGENCE_MAX_REVISIONS=1

# Portfolio analysis
PORTFOLIO_HISTORY_PERIOD=6mo
PORTFOLIO_CONCENTRATION_THRESHOLD_PCT=40

# Semantic memory
SEMANTIC_MEMORY_TOP_K=3

# Human review queue triggers
REVIEW_ON_HIGH_RISK=true
REVIEW_ON_COMPLIANCE_VIOLATION=true
REVIEW_ON_UNSUPPORTED_FIGURES=true
REVIEW_ON_MARKET_DATA_UNAVAILABLE=true
